PORT=8081

# Groq API key (free tier) — used to detect which workflow (industry) a
# customer's free-text message belongs to. If unset, a keyword-based
# fallback classifier is used instead, so the bot still works without it.
GROQ_API_KEY=

# Meta WhatsApp Cloud API (free test number). If unset, replies are only
# logged/printed instead of sent over WhatsApp — useful for local testing.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# App secret (Meta App Dashboard -> App Settings -> Basic -> App Secret).
# Used to verify the X-Hub-Signature-256 header on every webhook POST, so
# only Meta can send your bot messages. Strongly recommended in production —
# without it, anyone who finds your webhook URL can send it fake messages.
# Also auto-disables POST /api/simulate-whatsapp once set (re-enable with
# ALLOW_SIMULATE_ENDPOINT=true if you still need it in that environment).
WHATSAPP_APP_SECRET=

# Optional: protects GET /dashboard and /api/dashboard/* (bookings +
# availability). Without one, anyone who finds the URL can view all
# bookings and edit provider availability. Pass it as ?key=... or an
# X-Dashboard-Key header.
DASHBOARD_ACCESS_KEY=

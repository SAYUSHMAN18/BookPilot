PORT=8081

# Groq API key (free tier) — used to detect which workflow (industry) a
# customer's free-text message belongs to. If unset, a keyword-based
# fallback classifier is used instead, so the bot still works without it.
GROQ_API_KEY=

# Meta WhatsApp Cloud API (free test number). If unset, replies are only
# logged/printed instead of sent over WhatsApp — useful for local testing.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# App secret (Meta App Dashboard -> App Settings -> Basic -> App Secret).
# Used to verify the X-Hub-Signature-256 header on every webhook POST, so
# only Meta can send your bot messages. Strongly recommended in production —
# without it, anyone who finds your webhook URL can send it fake messages.
# Also auto-disables POST /api/simulate-whatsapp once set (re-enable with
# ALLOW_SIMULATE_ENDPOINT=true if you still need it in that environment).
WHATSAPP_APP_SECRET=

# Dashboard auth. Sessions are a signed cookie (HMAC), not a database
# session table — SESSION_SECRET is what makes that signature unforgeable.
# Required for anyone to log into /dashboard. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# One-time bootstrap for the first admin account. Only takes effect when
# the users table is completely empty — set both, start the server once,
# then you can unset them (or leave them; they're inert once a user exists).
# Create provider accounts afterward from the admin's "Manage Businesses"
# flow, or with a one-off script using src/userStore.js's users.create().
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Section 8 — same idea, for the platform-wide role (manages every
# tenant, distinct from any tenant's own admin). Gated on "does a
# platform_admin already exist" rather than "is the users table empty",
# so unlike ADMIN_BOOTSTRAP_* above it's safe to leave these set even
# after the first platform_admin exists — it won't create a second one.
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=

# Section 8 — encrypts secrets stored in the DB itself rather than only
# in .env: each tenant's own WhatsApp access token, and an optional
# bring-your-own Groq key override (src/infra/secretsEncryption.js,
# AES-256-GCM). Required before any tenant can have their own WhatsApp
# number connected — generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes every already-stored tenant secret undecryptable —
# back it up as carefully as you would a password, and never commit it.
APP_ENCRYPTION_KEY=

# Sarvam AI (https://sarvam.ai) — multilingual voice. With this set, a
# customer can send a WhatsApp voice note in any of ~23 Indian languages:
# it's transcribed, run through the exact same booking pipeline a typed
# message uses, and the reply is spoken back in the same language.
# Without it, voice notes get a polite "please type instead" reply and
# everything else works unchanged.
SARVAM_API_KEY=

# Set to 1 (or a hop count) ONLY when running behind a reverse proxy —
# it makes req.ip trust X-Forwarded-For, which is what the login rate
# limiter keys on. Leaving it unset with no proxy in front is correct;
# setting it without one would let a client spoof its own IP.
TRUST_PROXY=

# Section 9 — Razorpay (https://razorpay.com), for workflows/providers
# with requiresPayment: true. Get KEY_ID/KEY_SECRET from Settings -> API
# Keys in the Razorpay dashboard (test mode is fine for development).
# Without these, a payment-gated booking still completes as a normal
# confirmed booking instead of blocking the customer (logged as an ERROR
# so an admin notices) — see src/infra/paymentProviders/razorpayProvider.js.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Settings -> Webhooks in the Razorpay dashboard, once you've registered
# a public URL for POST /api/payments/webhook. Required for a payment to
# ever actually flip a booking from payment_pending to booked — nothing
# else is trusted to make that transition.
RAZORPAY_WEBHOOK_SECRET=

# Section 10 — Google Calendar sync. Create an OAuth 2.0 Client ID in the
# Google Cloud Console (APIs & Services -> Credentials), enable the
# Google Calendar API for the project, and add GOOGLE_REDIRECT_URI below
# as an authorized redirect URI. Without these, the dashboard's "Connect
# Google Calendar" button shows a clear "not configured" message instead
# of a broken link — see src/infra/calendarProviders/googleCalendarProvider.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an authorized redirect URI in the Google Cloud
# Console, e.g. https://your-domain.com/api/dashboard/calendar/callback
GOOGLE_REDIRECT_URI=

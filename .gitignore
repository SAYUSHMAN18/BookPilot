node_modules
.env

# Found live (production-readiness audit): these patterns were missing
# their src/ prefix, so they silently never matched src/logs/ or
# src/data/ — the app's ACTUAL log/DB paths (see src/infra/logger.js and
# src/store/db.js) — while the repo's real database and logs sat
# committed in git the entire time. Matching both the src/ paths this
# project actually uses AND the bare paths, in case a future refactor
# moves them back to the root.
logs/*.log
logs/*.jsonl
logs/sessions.json
logs/sessions.json.tmp
src/logs/*.log
src/logs/*.jsonl
src/logs/sessions.json
src/logs/sessions.json.tmp
data/*.db
data/*.db-wal
data/*.db-shm
src/data/*.db
src/data/*.db-wal
src/data/*.db-shm
backups/

# Found live (final audit pass) — real uploaded business/provider photos
# (src/infra/uploads.js's UPLOAD_DIR) land in data/uploads/<tenantId>/,
# a path none of the db-file globs above match. Uncovered, this is
# exactly the kind of thing a broad `git add .`/`git add -A` silently
# commits — real customer-facing image files, potentially real business
# photos, into git history.
data/uploads/
src/data/uploads/

# Stray root-level redirected output from manually running `node server.js
# > x.log` during local dev — not the app's own logger.js output (that's
# logs/app.log, already covered above).
/*.log

# Section 13 — the React/Vite rewrite's build output (frontend/ is the
# source; `npm run build` there generates this). Not committed, same as
# any other compiled artifact — rebuild it after a fresh clone.
public/app/

# Vite's own transient timestamped config-transform temp file — created
# and normally cleaned up by `vite build` itself, but a run interrupted
# mid-build can leave one behind.
frontend/vite.config.js.timestamp-*.mjs

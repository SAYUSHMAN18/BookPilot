  "providerListItem": "{provider.name} — {provider.attribute} (from ₹{provider.fee})",
  "providerRowDescription": "{provider.attribute} (from ₹{provider.fee})",
  "steps": [
    {
      "type": "select_provider",
      "prompt": "Choose a service center:"
    },
    {
      "type": "select_date",
      "field": "visitDate",
      "prompt": "Please select your preferred date."
    },
    {
      "type": "select_time_slot",
      "field": "visitTime",
      "dateField": "visitDate",
      "prompt": "Please choose a time slot."
    },
    {
      "type": "text_input",
      "field": "customerName",
      "prompt": "What name should I book this under?",
      "validate": "required",
      "validationError": "Please share a name.",
      "editTarget": true
    },
    {
      "type": "text_input",
      "field": "reason",
      "prompt": "What service does your vehicle need? (e.g. oil change, tyre replacement, general checkup)",
      "validate": "required",
      "validationError": "Please describe what service you need."
    },
    {
      "type": "review_confirm",
      "prompt": "Please review your booking.",
      "template": "🔧 {provider.name} ({provider.attribute})\n📅 Date: {visitDateLabel}\n⏰ Time: {visitTime}\n👤 For: {customerName}\n📝 Service needed: {reason}\n💰 Starting from: ₹{provider.fee}"
    }
  ],
  "confirmationTemplate": "✅ Booking confirmed!\n\n🆔 Booking ID: {bookingId}\n🔧 {provider.name}\n📅 Date: {visitDateLabel}\n⏰ Time: {visitTime}\n📝 Service: {reason}\n💰 Starting from: ₹{provider.fee}\n📍 {businessName}, {provider.address}\n🗺️ https://www.google.com/maps/search/?api=1&query={provider.mapQuery}\n🔑 Booking Code: {bookingCode}\n\nReply STATUS anytime to check your booking."
}
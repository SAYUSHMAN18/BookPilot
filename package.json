{
  "name": "bookpilot-ai",
  "version": "0.1.0",
  "description": "AI-powered WhatsApp booking bot driven by a config-based dynamic workflow engine. Add a new industry by dropping a JSON file in workflows/ — no code changes required.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:dashboard": "node server.js",
    "start:marketing": "node marketingServer.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit -p jsconfig.json",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^7.0.2"
  }
}
